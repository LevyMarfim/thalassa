#!/usr/bin/env bash
#
# Docker leaves stale raw-table rules behind when a bridge network is removed:
#
#   -A PREROUTING -d 172.18.0.3/32 ! -i br-<old-bridge> -j DROP
#
# The next `docker compose up` creates a new bridge, so the leftover rule no
# longer matches the interface the app's traffic arrives on and drops every
# packet from the containers on it. The visible symptom is the app timing out
# for 30 seconds on the PostgreSQL connection, i.e. login that never finishes.
#
# This removes only rules whose "! -i br-..." interface no longer exists on the
# host, so rules belonging to live Docker networks are never touched.
#
# iptables needs CAP_NET_ADMIN which the desktop user does not have, so the
# inspection and deletion run in a short-lived privileged container chrooted
# into the host. The rule list is read with iptables-save and replayed with
# iptables -D, which only affects the exact rule shape above.

set -u

IMAGE="postgres:18-alpine"

if ! command -v docker >/dev/null 2>&1; then
    echo "fix-docker-firewall: docker not found, skipping" >&2
    exit 0
fi

docker run --rm --privileged --net=host -v /:/host --entrypoint /bin/sh "$IMAGE" -c '
    rules=$(chroot /host iptables-save -t raw 2>/dev/null) || {
        echo "fix-docker-firewall: cannot read the host firewall" >&2
        exit 3
    }

    printf "%s\n" "$rules" \
        | grep -E "^-A PREROUTING -d ([0-9]{1,3}\.){3}[0-9]{1,3}/32 ! -i br-[[:alnum:]]+ -j DROP$" \
        | while IFS= read -r rule; do
            bridge=$(printf "%s\n" "$rule" | sed -E "s/.*! -i (br-[[:alnum:]]+).*/\1/")
            if [ -d "/host/sys/class/net/$bridge" ]; then
                continue
            fi

            if chroot /host iptables -t raw $(printf "%s\n" "$rule" | sed "s/^-A /-D /"); then
                printf "Removed stale Docker firewall rule (%s no longer exists)\n" "$bridge"
            fi
        done
' || {
    echo "fix-docker-firewall: could not inspect the host firewall, skipping; if login hangs, run 'make firewall-fix'" >&2
    exit 0
}

exit 0
