{# templates/accounts/index.html.twig — overview, search/sort, list and create #}
{% extends 'layouts/dashboard.html.twig' %}
{% set active_nav = 'accounts' %}

{% block title %}Accounts · FinFlow{% endblock %}

{% block dashboard_content %}
        <header class="dash-header dash-header--split">
            <div>
                <h1>Accounts</h1>
                <p>Your bank and brokerage accounts, in BRL and USD.</p>
            </div>
            <a class="btn btn--primary" href="#new-account">Add account</a>
        </header>

        <div class="dash-grid">
            {% if accountCount > 0 %}
                <section class="card card--wide" aria-labelledby="overview-heading">
                    <h2 id="overview-heading" class="sr-only">Balance overview</h2>
                    <div class="account-summary__grid">
                        {% for summary in currencySummaries %}
                            <div class="account-summary__item">
                                <span class="account-summary__label">{{ summary.currency.value }} total</span>
                                <span class="account-summary__value {{ summary.total < 0 ? 'account-summary__value--negative' : '' }}">
                                    {{ summary.symbol }} {{ summary.total|number_format(2, ',', '.') }}
                                </span>
                                <span class="account-summary__meta">{{ summary.count }} {{ summary.count == 1 ? 'account' : 'accounts' }}</span>
                            </div>
                        {% endfor %}
                        <div class="account-summary__item account-summary__item--muted">
                            <span class="account-summary__label">Your accounts</span>
                            <span class="account-summary__value">{{ accountCount }}</span>
                            <span class="account-summary__meta">{{ activeCount }} active · {{ accountCount - activeCount }} inactive</span>
                        </div>
                    </div>
                </section>
            {% endif %}

            <section class="card card--wide" aria-labelledby="filters-heading">
                <h2 id="filters-heading">Find an account</h2>
                {{ form_start(filterForm, {attr: {class: 'tx-form account-filter-form'}}) }}
                    <div class="form-field">
                        {{ form_label(filterForm.name, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(filterForm.name) }}
                        {{ form_errors(filterForm.name) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(filterForm.currency, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(filterForm.currency) }}
                        {{ form_errors(filterForm.currency) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(filterForm.status, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(filterForm.status) }}
                        {{ form_errors(filterForm.status) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(filterForm.sort, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(filterForm.sort) }}
                        {{ form_errors(filterForm.sort) }}
                    </div>
                    <div class="tx-form__actions">
                        <button type="submit" class="btn btn--primary">Apply filters</button>
                        <a class="btn btn--ghost" href="{{ path('app_accounts') }}">Clear</a>
                    </div>
                {{ form_end(filterForm) }}
            </section>

            <section class="card card--wide" aria-labelledby="list-heading">
                <div class="card__heading-row">
                    <h2 id="list-heading">All accounts</h2>
                    <span class="card__count">Showing {{ accounts|length }} of {{ accountCount }}</span>
                </div>

                {% if filter.active %}
                    <p class="tx-filter">
                        Filtered view
                        <a href="{{ path('app_accounts') }}">Show all</a>
                    </p>
                {% endif %}

                {% if accounts is empty %}
                    <div class="empty-state">
                        {% if filter.active %}
                            <p>No accounts match these filters.</p>
                            <small>Try another name or <a href="{{ path('app_accounts') }}">clear the filters</a>.</small>
                        {% else %}
                            <p>No accounts yet.</p>
                            <small>Add your first one with the form below, e.g. Nubank or XP Investimentos.</small>
                        {% endif %}
                    </div>
                {% else %}
                    <ul class="type-list account-list">
                        {% for account in accounts %}
                            <li class="type-list__row">
                                <a class="type-list__name type-list__link" href="{{ path('app_transactions', {account: account.id}) }}" title="View transactions for {{ account.name }}">
                                    {{ account.name }}
                                    {% if account.active %}
                                        <span class="account-badge account-badge--active">Active</span>
                                    {% else %}
                                        <span class="account-badge account-badge--inactive">Inactive</span>
                                    {% endif %}
                                </a>
                                <span class="account-currency">{{ account.currency.value }}</span>
                                {% set balance = balances[account.id]|default(0) %}
                                <span class="account-balance {{ balance < 0 ? 'account-balance--negative' }}">
                                    {{ account.currency.symbol }}
                                    {{ balance|number_format(2, ',', '.') }}
                                </span>
                                <a class="type-list__edit" href="{{ path('app_accounts_edit', {id: account.id}) }}">Edit</a>
                                <form class="type-list__delete-form" method="post" action="{{ path('app_accounts_delete', {id: account.id}) }}" onsubmit="return confirm('Remove account {{ account.name }}?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-account') }}">
                                    <button type="submit" class="type-list__delete">Remove</button>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <section class="card" id="new-account" aria-labelledby="add-heading">
                <h2 id="add-heading">Add account</h2>
                <p class="help-text">Track a bank, brokerage or wallet in its own currency.</p>

                {{ form_start(form, {attr: {class: 'settings-form', novalidate: 'novalidate'}}) }}
                    {# Root-level errors (CSRF, UniqueEntity) attach to the form
                       itself, not a field, so they render nowhere without this. #}
                    {{ form_errors(form) }}
                    <div class="form-field">
                        {{ form_label(form.name, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.name) }}
                        {{ form_help(form.name) }}
                        {{ form_errors(form.name) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(form.currency, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.currency) }}
                        {{ form_help(form.currency) }}
                        {{ form_errors(form.currency) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(form.active, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.active) }}
                        {{ form_help(form.active) }}
                        {{ form_errors(form.active) }}
                    </div>

                    <button type="submit" class="btn btn--primary btn--block">Add account</button>
                {# Not render_rest: false — that suppresses form_rest(), which is
                   what emits the CSRF token. Every field above is rendered
                   explicitly, so form_end() here emits only the token. #}
                {{ form_end(form) }}
            </section>
        </div>
{% endblock %}
