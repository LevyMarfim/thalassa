{# templates/home/index.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard · FinFlow{% endblock %}

{% block dashboard_content %}
        <header class="dash-header">
            <h1>Welcome back, {{ app.user.username }}</h1>
            <p>Here is your money overview in BRL and USD.</p>
        </header>

        <div class="dash-grid">
            <section class="card" aria-labelledby="profile-heading">
                <h2 id="profile-heading">Profile</h2>
                <dl>
                    <div class="profile-row">
                        <dt>Username</dt>
                        <dd>{{ app.user.username }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Email</dt>
                        <dd>{{ app.user.email }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Member since</dt>
                        <dd>{{ app.user.createdAt|date('d/m/Y', 'America/Sao_Paulo') }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Last access</dt>
                        <dd>{{ app.user.lastAccessAt ? app.user.lastAccessAt|date('d/m/Y H:i', 'America/Sao_Paulo') : '—' }}</dd>
                    </div>
                    <div class="profile-row">
                        <dt>Status</dt>
                        <dd><span class="status-badge">{{ app.user.active ? 'Active' : 'Inactive' }}</span></dd>
                    </div>
                </dl>
            </section>

            <section class="card" aria-labelledby="accounts-heading">
                <h2 id="accounts-heading">Accounts</h2>
                {% if accounts is empty %}
                    <div class="empty-state">
                        <p>No accounts yet.</p>
                        <small>Your BRL and USD accounts will appear here.</small>
                    </div>
                {% else %}
                    <ul class="type-list account-list">
                        {% for account in accounts %}
                            <li class="type-list__row">
                                <span class="type-list__name">
                                    {{ account.name }}
                                    {% if not account.active %}
                                        <span class="account-badge account-badge--inactive">Inactive</span>
                                    {% endif %}
                                </span>
                                <span class="account-currency">{{ account.currency.value }}</span>
                                {% set balance = balances[account.id]|default(0) %}
                                <span class="account-balance {{ balance < 0 ? 'account-balance--negative' }}">
                                    {{ account.currency.symbol }}
                                    {{ balance|number_format(2, ',', '.') }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="card__back">
                        <a href="{{ path('app_accounts') }}">Manage accounts →</a>
                    </p>
                {% endif %}
            </section>

            <section class="card card--wide" aria-labelledby="activity-heading">
                <h2 id="activity-heading">Recent activity</h2>

                {% if recentTransactions is empty %}
                    <div class="empty-state">
                        <p>No recent activity.</p>
                        <small>PIX, transfers and bills will show up here once you add a transaction.</small>
                    </div>
                {% else %}
                    <ul class="type-list">
                        {% for transaction in recentTransactions %}
                            <li class="type-list__row">
                                <span class="tx-badge tx-badge--{{ transaction.operation.value|lower }}">
                                    {{ transaction.operation.labels }}
                                </span>
                                <span class="type-list__name">
                                    {{ transaction.description }}
                                    <small class="activity-meta">
                                        {{ transaction.account.name }} ·
                                        {{ transaction.movement|date('d/m/Y') }}
                                    </small>
                                </span>
                                {# ABS() because the stored sign is not reliable — the operation
                                   enum is the sole source of direction (see AccountRepository). #}
                                <span class="account-balance {{ transaction.operation.value|lower == 'debit' ? 'account-balance--negative' }}">
                                    {{ transaction.account.currency.symbol }}
                                    {{ (transaction.totalPrice|abs)|number_format(2, ',', '.') }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="card__back">
                        <a href="{{ path('app_transactions') }}">View all transactions →</a>
                    </p>
                {% endif %}
            </section>
        </div>
{% endblock %}
