{# templates/home/index.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}

{% block title %}Dashboard · FinFlow{% endblock %}

{% block dashboard_content %}
    <div class="home-page">
        <header class="dash-header dash-header--split">
            <div>
                <h1>Welcome back, {{ app.user.username }}</h1>
                <p>Here is your money overview in BRL and USD.</p>
            </div>
            <a class="btn btn--ghost" href="{{ path('app_transactions') }}">View transactions →</a>
        </header>

        <div class="home-layout">
            {% if currencySummaries is not empty %}
                <section class="card card--compact home-span-12" aria-labelledby="home-summary-heading">
                    <h2 id="home-summary-heading" class="sr-only">Movement overview</h2>
                    <div class="tx-summary__grid">
                        {% for summary in currencySummaries %}
                            <div class="tx-summary__item">
                                <span class="tx-summary__label">{{ summary.currency.value }} net movement</span>
                                <span class="tx-summary__value {{ summary.total < 0 ? 'tx-summary__value--negative' : '' }}">
                                    {{ summary.symbol }} {{ summary.total|number_format(2, ',', '.') }}
                                </span>
                                <span class="tx-summary__meta">{{ summary.count }} {{ summary.count == 1 ? 'transaction' : 'transactions' }}</span>
                            </div>
                        {% endfor %}
                        <div class="tx-summary__item tx-summary__item--muted">
                            <span class="tx-summary__label">On record</span>
                            <span class="tx-summary__value">{{ transactionCount }}</span>
                            <span class="tx-summary__meta">{{ transactionCount == 1 ? 'transaction' : 'transactions' }} across all accounts</span>
                        </div>
                    </div>
                </section>
            {% endif %}

            <section class="card card--compact home-span-12" aria-labelledby="chart-heading">
                <h2 id="chart-heading">Account value by month</h2>
                <p class="card__hint">Month-end balance per account. Hover the chart for exact values, toggle accounts in the legend, and switch the range.</p>

                {% if charts is empty %}
                    <div class="empty-state">
                        <p>No account history yet.</p>
                        <small>Add a transaction and your month-end balances will appear here.</small>
                    </div>
                {% else %}
                    <div class="chart-panels chart-panels--compact">
                        {% for chart in charts %}
                            {{ include('components/_monthly_balance_chart.html.twig', {chart: chart}) }}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <section class="card card--compact home-span-12" aria-labelledby="monthly-heading">
                <h2 id="monthly-heading">Monthly movement</h2>
                {% if monthlyCharts is empty %}
                    <div class="empty-state">
                        <p>No monthly activity yet.</p>
                        <small>It appears here as you record transactions.</small>
                    </div>
                {% else %}
                    <div class="chart-panels chart-panels--compact">
                        {% for chart in monthlyCharts %}
                            {{ include('components/_transaction_monthly_chart.html.twig', {chart: chart}) }}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <section class="card card--compact home-span-12" aria-labelledby="monthly-types-heading">
                <h2 id="monthly-types-heading">Monthly movement by operation type</h2>
                <p class="card__hint">Pick an operation type to plot its monthly totals. Values are absolute money moved, not a signed balance.</p>

                {% if monthlyTypeCharts is empty %}
                    <div class="empty-state">
                        <p>No monthly activity yet.</p>
                        <small>Operation types appear here as you record transactions.</small>
                    </div>
                {% else %}
                    <div class="chart-panels chart-panels--compact">
                        {% for chart in monthlyTypeCharts %}
                            {{ include('components/_monthly_type_chart.html.twig', {chart: chart}) }}
                        {% endfor %}
                    </div>
                {% endif %}
            </section>

            <section class="card card--compact home-span-6" aria-labelledby="operations-heading">
                <h2 id="operations-heading">Credits and debits</h2>
                {% if operationCharts is empty %}
                    <div class="empty-state">
                        <p>No operations yet.</p>
                        <small>Recorded credits and debits will appear here.</small>
                    </div>
                {% else %}
                    <div class="chart-panels chart-panels--compact">
                        {{ include('components/_operation_value_chart.html.twig', {charts: operationCharts}) }}
                    </div>
                {% endif %}
            </section>

            <section class="card card--compact home-span-6" aria-labelledby="types-heading">
                <h2 id="types-heading">Operation types</h2>
                {% if typeCharts is empty %}
                    <div class="empty-state">
                        <p>No operation types yet.</p>
                        <small>They appear here as you record transactions.</small>
                    </div>
                {% else %}
                    <div class="chart-panels chart-panels--compact">
                        {{ include('components/_transaction_type_chart.html.twig', {charts: typeCharts}) }}
                    </div>
                {% endif %}
            </section>

            <section class="card card--compact home-span-12" aria-labelledby="activity-heading">
                <h2 id="activity-heading">Recent activity</h2>

                {% if recentTransactions is empty %}
                    <div class="empty-state">
                        <p>No recent activity.</p>
                        <small>PIX, transfers and bills will show up here once you add a transaction.</small>
                    </div>
                {% else %}
                    <ul class="type-list">
                        {% for transaction in recentTransactions %}
                            <li class="type-list__row">
                                <span class="tx-badge tx-badge--{{ transaction.operation.value|lower }}">
                                    {{ transaction.operation.labels }}
                                </span>
                                <span class="type-list__name">
                                    {{ transaction.description }}
                                    <small class="activity-meta">
                                        {{ transaction.account.name }} ·
                                        {{ transaction.movement|date_only }}
                                    </small>
                                </span>
                                {# Signed by the operation: a debit is money out and
                                   renders negative, matching the account balance. #}
                                <span class="account-balance {{ transaction.operation.value|lower == 'debit' ? 'account-balance--negative' }}">
                                    {{ transaction.account.currency.symbol }}
                                    {{ transaction.signedTotalPrice|number_format(2, ',', '.') }}
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                    <p class="card__back">
                        <a href="{{ path('app_transactions') }}">View all transactions →</a>
                    </p>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
