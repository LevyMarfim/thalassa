{# One currency's monthly credits/debits as a compact grouped-bar chart.
   The server sends the full filtered history; this figure renders the same
   3M/6M/1Y/2Y/3Y/5Y/All selector as the dashboard balance chart and the Stimulus
   controller slices the data client-side. #}
{% set available_months = chart.labels|length %}
{% set default_is_all = chart.defaultRange == 0 %}
<figure class="chart-panel chart-panel--compact"
        data-controller="transaction-chart"
        data-transaction-chart-kind-value="monthly"
        data-transaction-chart-data-value="{{ chart|json_encode|e('html_attr') }}">
    <figcaption>
        <span>{{ chart.title }} · monthly movement</span>
        {{ include('components/_chart_range_buttons.html.twig', {chart: chart}) }}
    </figcaption>

    <div class="chart-canvas-wrap chart-canvas-wrap--compact">
        <canvas data-transaction-chart-target="canvas"
                role="img"
                aria-label="Monthly credits and debits for {{ chart.title }} accounts"></canvas>
    </div>

    <p class="chart-summary" data-transaction-chart-target="summary" aria-live="polite">
        {% if default_is_all %}
            All time ({{ available_months }} {{ available_months == 1 ? 'month' : 'months' }})
        {% else %}
            Last {{ chart.defaultRange }} months
        {% endif %}
    </p>

    <noscript>
        <p class="chart-noscript">Enable JavaScript to see the chart.</p>
    </noscript>
</figure>
