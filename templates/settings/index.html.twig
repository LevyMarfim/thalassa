{# templates/settings/index.html.twig #}
{% extends 'layouts/dashboard.html.twig' %}
{% set active_nav = 'settings' %}

{% block title %}Settings · FinFlow{% endblock %}

{% block dashboard_content %}
        <header class="dash-header">
            <h1>Settings</h1>
            <p>Manage your FinFlow account.</p>
        </header>

        <div class="dash-grid">
            <section class="card" aria-labelledby="email-heading">
                <h2 id="email-heading">Email address</h2>

                {{ form_start(emailForm, {attr: {class: 'settings-form', novalidate: 'novalidate'}}) }}
                    <div class="form-field">
                        {{ form_label(emailForm.email, 'Email address', {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(emailForm.email, {attr: {class: 'form-input'}}) }}
                        {{ form_errors(emailForm.email) }}
                    </div>

                    <button type="submit" class="btn btn--primary btn--block">Save email</button>
                {{ form_end(emailForm) }}
            </section>

            <section class="card" aria-labelledby="password-heading">
                <h2 id="password-heading">Password</h2>

                {{ form_start(passwordForm, {attr: {class: 'settings-form', novalidate: 'novalidate'}}) }}
                    <div class="form-field">
                        {{ form_label(passwordForm.currentPassword, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(passwordForm.currentPassword, {attr: {class: 'form-input'}}) }}
                        {{ form_errors(passwordForm.currentPassword) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(passwordForm.newPassword.first, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(passwordForm.newPassword.first, {attr: {class: 'form-input'}}) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(passwordForm.newPassword.second, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(passwordForm.newPassword.second, {attr: {class: 'form-input'}}) }}
                        {{ form_errors(passwordForm.newPassword) }}
                    </div>

                    <button type="submit" class="btn btn--primary btn--block">Save password</button>
                {{ form_end(passwordForm) }}
            </section>
            <section class="card card--wide" aria-labelledby="operation-types-heading">
                <h2 id="operation-types-heading">Operation types</h2>

                {% if operationTypes is empty %}
                    <div class="empty-state">
                        <p>No operation types yet.</p>
                        <small>Add the first one below, e.g. PIX, TED or boleto.</small>
                    </div>
                {% else %}
                    <ul class="type-list">
                        {% for operationType in operationTypes %}
                            <li class="type-list__row">
                                <span class="type-list__name">{{ operationType.type }}</span>
                                <span class="op-badge op-badge--{{ operationType.operation.value|lower }}">{{ operationType.operation.labels }}</span>
                                <a class="type-list__edit" href="{{ path('app_settings_operation_type_edit', {id: operationType.id}) }}">Edit</a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}

                {{ form_start(operationTypeForm, {attr: {class: 'settings-form settings-form--inline', novalidate: 'novalidate'}}) }}
                    <div class="form-field">
                        {{ form_label(operationTypeForm.type, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(operationTypeForm.type, {attr: {class: 'form-input'}}) }}
                        {{ form_errors(operationTypeForm.type) }}
                    </div>
                    <div class="form-field">
                        {{ form_label(operationTypeForm.operation, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(operationTypeForm.operation, {attr: {class: 'form-input'}}) }}
                        {{ form_errors(operationTypeForm.operation) }}
                    </div>

                    <button type="submit" class="btn btn--primary">Add</button>
                {{ form_end(operationTypeForm) }}
            </section>
        </div>
{% endblock %}
