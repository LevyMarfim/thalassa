{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Create your account{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('styles/auth.css') }}">
    <link rel="stylesheet" href="{{ asset('styles/registration.css') }}">
{% endblock %}


{% block body %}
<div class="auth-page">
    <div class="auth-shell">

        <aside class="auth-aside" aria-hidden="true">
            <div class="auth-aside__brand">
                <span class="auth-aside__logo">{{ include('components/_logo.svg') }}</span>
                <span class="auth-aside__name">FinFlow</span>
            </div>

            <div class="auth-aside__content">
                <h2>Take control of your finances</h2>
                <p>Track spending, plan budgets, and grow your savings — all in one place.</p>

                <ul class="auth-aside__list">
                    <li>
                        <span class="auth-aside__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </span>
                        Real-time account insights
                    </li>
                    <li>
                        <span class="auth-aside__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </span>
                        Smart budgeting tools
                    </li>
                    <li>
                        <span class="auth-aside__check" aria-hidden="true">
                            <svg viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                        </span>
                        Bank-grade security
                    </li>
                </ul>
            </div>

            <p class="auth-aside__footnote">© {{ "now"|date("Y") }} FinFlow. All rights reserved.</p>
        </aside>

        <main class="auth-main">
            <div class="auth-card" data-controller="registration">
                <header class="auth-card__header">
                    <h1>Create your account</h1>
                    <p>Start managing your money in under a minute.</p>
                </header>

                {{ form_start(registrationForm, {
                    attr: {
                        class: 'auth-form',
                        novalidate: 'novalidate',
                        'data-action': 'submit->registration#validate'
                    }
                }) }}

                    <div class="form-field">
                        {{ form_label(registrationForm.email, 'Email address', { label_attr: { class: 'form-label' } }) }}
                        <div class="form-input-wrap">
                            {{ form_widget(registrationForm.email, {
                                attr: {
                                    class: 'form-input',
                                    placeholder: 'you@example.com',
                                    'data-registration-target': 'email'
                                }
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="form-field">
                        {{ form_label(registrationForm.username, 'Username', { label_attr: { class: 'form-label' } }) }}
                        <div class="form-input-wrap">
                            {{ form_widget(registrationForm.username, {
                                attr: {
                                    class: 'form-input',
                                    placeholder: 'johndoe',
                                    'data-registration-target': 'username'
                                }
                            }) }}
                        </div>
                        {{ form_errors(registrationForm.username) }}
                    </div>

                    <div class="form-field">
                        {{ form_label(registrationForm.plainPassword, 'Password', { label_attr: { class: 'form-label' } }) }}
                        <div class="form-input-wrap">
                            {{ form_widget(registrationForm.plainPassword, {
                                attr: {
                                    class: 'form-input form-input--password',
                                    placeholder: 'At least 6 characters',
                                    'data-registration-target': 'password',
                                    'data-action': 'input->registration#updateStrength'
                                }
                            }) }}
                            <button type="button"
                                    class="form-input__toggle"
                                    data-action="click->registration#togglePassword"
                                    aria-label="Show password"
                                    aria-pressed="false">
                                <svg class="icon-eye" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                                    <path fill="currentColor" d="M12 5c-7 0-10 7-10 7s3 7 10 7 10-7 10-7-3-7-10-7zm0 12a5 5 0 1 1 0-10 5 5 0 0 1 0 10zm0-8a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/>
                                </svg>
                                <svg class="icon-eye-off" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                                    <path fill="currentColor" d="M12 7a5 5 0 0 1 5 5c0 .65-.13 1.26-.36 1.83l2.92 2.92A11.8 11.8 0 0 0 22 12s-3-7-10-7c-1.27 0-2.4.22-3.4.6l2.16 2.16C11.24 7.28 11.6 7 12 7zM2 4.27l2.28 2.28.46.46A11.8 11.8 0 0 0 2 12s3 7 10 7c1.55 0 2.94-.34 4.17-.88l.42.42L18.73 20 20 18.73 3.27 2 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65a3 3 0 0 0 3 3c.22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53a5 5 0 0 1-5-5c0-.79.2-1.53.53-2.2zm4.31-.78 3.15 3.15.02-.16a3 3 0 0 0-3-3l-.17.01z"/>
                                </svg>
                            </button>
                        </div>

                        <div class="password-strength" data-registration-target="strength" data-level="0">
                            <div class="password-strength__bars">
                                <span></span><span></span><span></span><span></span>
                            </div>
                            <p class="password-strength__label" data-registration-target="strengthLabel">Use 6+ characters with a mix of letters, numbers, and symbols.</p>
                        </div>

                        {{ form_errors(registrationForm.plainPassword) }}
                    </div>

                    <div class="form-field form-field--checkbox">
                        {{ form_widget(registrationForm.agreeTerms, {
                            attr: { class: 'form-checkbox' }
                        }) }}
                        <div class="form-checkbox-label">
                            {{ form_label(registrationForm.agreeTerms) }}
                            <p class="form-checkbox-hint">You can review our <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.</p>
                        </div>
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="btn btn--primary btn--block">
                        Create account
                    </button>
                {{ form_end(registrationForm) }}

                <p class="auth-card__footer">
                    Already have an account?
                    <a href="{{ path('app_login') }}">Sign in</a>
                </p>
            </div>
        </main>
    </div>
</div>
{% endblock %}